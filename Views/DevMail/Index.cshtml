@model IReadOnlyList<DevMail>
@{ ViewData["Title"] = "Тестова пошта"; }
<div class="page-heading"><div><div class="eyebrow eyebrow-small">LOCAL DEV TOOLS <span class="eyebrow-line"></span> ONLY LOCALHOST</div><h1>Тестова <span class="gradient-text">пошта.</span></h1><p>Усі посилання для активації та відновлення зберігаються тільки локально у режимі Development.</p></div><a class="btn btn-secondary" asp-controller="Home" asp-action="Index">← Головна</a></div>
<div class="notice">Це інструмент демонстрації. У Production ця сторінка недоступна, а листи надсилаються через SMTP. Не використовуйте тестову пошту для реальних персональних даних.</div>
<div class="mail-list">
    @foreach(var mail in Model)
    {
        <div class="mail-item"><div class="mail-icon">✉</div><div class="mail-info"><div class="mail-top"><span class="state-label state-neutral">@mail.Category</span><span class="muted-help">@mail.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm:ss") UTC</span></div><h3>@mail.Subject</h3><p>Кому: <strong>@mail.Recipient</strong></p></div><a class="btn btn-secondary" href="@mail.ActionUrl">Відкрити посилання ↗</a></div>
    }
    @if(Model.Count == 0){ <div class="mail-item"><p>Тут ще немає листів. Створіть акаунт, щоб отримати лист активації.</p></div> }
</div>
