@model Verify2FaVm
@{ ViewData["Title"] = "Перевірка 2FA"; }
<div class="narrow-layout"><div class="form-card standalone"><div class="form-topline">ДРУГИЙ ФАКТОР <span>STEP 02 / 02</span></div><div class="big-icon">◈</div><h1>Майже готово.</h1><p>Відкрийте застосунок-автентифікатор і введіть поточний шестизначний код.</p><form asp-action="Verify2Fa" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post"><div asp-validation-summary="All" class="validation-summary"></div><input asp-for="RememberMe" type="hidden" /><div class="field"><label asp-for="Code">Код автентифікатора</label><input asp-for="Code" inputmode="numeric" pattern="[0-9 -]{6,10}" autocomplete="one-time-code" class="otp-input" maxlength="10" placeholder="000 000" /></div><button class="btn btn-primary full" type="submit">Підтвердити вхід →</button></form><p class="form-note">Код змінюється приблизно кожні 30 секунд.</p></div></div>
