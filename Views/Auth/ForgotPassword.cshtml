@model ForgotPasswordVm
@{ ViewData["Title"] = "Відновлення пароля"; }
<div class="narrow-layout"><div class="form-card standalone"><div class="form-topline">ACCOUNT RECOVERY <span>SECURE FLOW</span></div><div class="big-icon">↺</div><h1>Відновлення пароля</h1><p>Вкажіть пошту вашого акаунта. Ми надішлемо посилання, яке діє одну годину.</p><form asp-action="ForgotPassword" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field"><label asp-for="Email">Електронна пошта</label><input asp-for="Email" type="email" autocomplete="email" placeholder="name@example.com" /><span asp-validation-for="Email" class="field-error"></span></div><button class="btn btn-primary full" type="submit">Надіслати посилання →</button></form><a class="back-link" asp-action="Login">← Назад до входу</a></div></div>
