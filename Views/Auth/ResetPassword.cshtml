@model ResetPasswordVm
@{ ViewData["Title"] = "Новий пароль"; }
<div class="narrow-layout"><div class="form-card standalone"><div class="form-topline">ACCOUNT RECOVERY <span>NEW CREDENTIALS</span></div><div class="big-icon">⌘</div><h1>Новий пароль</h1><p>Створіть складний пароль, що відповідає політиці безпеки.</p><form asp-action="ResetPassword" method="post"><input asp-for="UserId" type="hidden"/><input asp-for="Token" type="hidden"/><div asp-validation-summary="All" class="validation-summary"></div><div class="field"><label asp-for="Password">Новий пароль</label><input asp-for="Password" type="password" autocomplete="new-password" data-password-input placeholder="Мінімум 8 символів" /></div><div class="password-meter"><div data-password-meter></div></div><div class="password-rules" data-password-rules><span data-rule="length">8+ символів</span><span data-rule="case">A + a</span><span data-rule="digit">Цифра 0–9</span><span data-rule="symbol">Символ !#?</span></div><div class="field"><label asp-for="ConfirmPassword">Повторіть пароль</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" /></div><button type="submit" class="btn btn-primary full">Зберегти новий пароль →</button></form></div></div>
